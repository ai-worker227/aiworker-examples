  "type": "module",
  "scripts": {
    "test": "vitest run --root .. --config vitest.config.ts elizaos",
    "example": "tsx example.ts",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "zod": "^3.24.0",
    "@x402/core": "2.24.0",
